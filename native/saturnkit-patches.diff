+// The FRT's input-capture interrupt, for a program that takes SINIT/MINIT as an interrupt (TIER's
+// ICIE) instead of polling FTCSR: while ICF is set it is raised at the level in IPRB bits 11-8 with
+// the vector in VCRC bits 14-8, and the handler clears ICF.
+bool onchip_frt_interrupt(SH2Context& c) {
+    OnChip& o = g_oc[c.cpu];
+    if (!(o.regs[0x11] & 0x80) || !(o.regs[0x10] & 0x80)) return false;
+    uint32_t level = o.regs[0x60] & 0x0F;
+    if (level <= c.imask) return false;
+    sat_interrupt(c, o.regs[0x66] & 0x7F, level);
+    return true;
+}
